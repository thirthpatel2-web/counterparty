# Copy to .env and fill in. Never commit .env.
# LLM provider: groq (default), nvidia (Nemotron on build.nvidia.com), or openai (any OpenAI-compatible API)
LLM_PROVIDER=groq
GROQ_API_KEY=
# NVIDIA_API_KEY=
# For LLM_PROVIDER=openai:
# LLM_BASE_URL=
# LLM_API_KEY=
# COUNTERPARTY_MODEL=openai/gpt-oss-120b
HINDSIGHT_API_KEY=
# Only for self-hosted Hindsight, for example http://localhost:8888
# HINDSIGHT_BASE_URL=
# Hindsight bank for live Band room negotiations (default: counterparty-band-room)
# COUNTERPARTY_ROOM_BANK=
